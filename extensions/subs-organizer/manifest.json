{
  "manifest_version": 3,
  "name": "구독 채널 정리함",
  "version": "0.1.0",
  "description": "YouTube 구독 채널을 한눈에 보고 정리하거나, 여러 계정의 구독을 하나로 합칩니다. 데이터는 이 브라우저 밖으로 나가지 않습니다.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "구독 채널 정리함",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://util.cokeys90.dev/subs-organizer/"
}
