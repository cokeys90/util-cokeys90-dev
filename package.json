{
  "name": "util-cokeys90-dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "util.cokeys90.dev — web tools & Chrome extensions hub",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node kit/scripts/prerender.mjs && node kit/scripts/build-site.mjs",
    "build:strict": "vite build && node kit/scripts/prerender.mjs && node kit/scripts/build-site.mjs --strict",
    "preview": "vite preview",
    "pack:ext": "node kit/scripts/pack.mjs",
    "new:ext": "node kit/scripts/new-extension.mjs",
    "check": "node kit/scripts/check.mjs && tsc -p web && eslint .",
    "lint": "eslint .",
    "verify": "npm run check && npm run build:strict && node kit/scripts/verify-dist.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,mjs,ts,tsx,json,css,md,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
